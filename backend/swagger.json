{
  "openapi": "3.0.3",
  "info": {
    "title": "my-ToDoList API",
    "description": "인증된 사용자가 개인별 Todo를 카테고리 단위로 관리하는 API. Category는 Admin이 전역으로 관리하고, 일반 사용자는 조회/선택만 가능하다.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버" }
  ],
  "tags": [
    { "name": "Auth", "description": "회원가입/로그인/토큰 재발급/로그아웃" },
    { "name": "Users", "description": "회원정보 수정 및 회원 목록 조회" },
    { "name": "Categories", "description": "카테고리 조회 및 Admin 관리" },
    { "name": "Todos", "description": "Todo CRUD 및 필터링" },
    { "name": "Health", "description": "헬스체크" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "헬스체크 (DB 연결 확인)",
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "500": {
            "description": "DB 연결 실패",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "이메일 형식 오류 또는 이메일 중복(목록 내 중복 체크만 수행, 실제 이메일 존재 여부는 검증하지 않음)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인 (Access Token은 응답 바디, Refresh Token은 httpOnly 쿠키)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공. Refresh Token은 Set-Cookie(httpOnly)로 전달되며 응답 바디에는 포함되지 않는다.",
            "headers": {
              "Set-Cookie": {
                "description": "refreshToken=...; HttpOnly; Path=/; Secure",
                "schema": { "type": "string" }
              }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "이메일/비밀번호 불일치(계정 존재 여부는 노출하지 않음)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Access Token 재발급 (httpOnly 쿠키의 Refresh Token 사용)",
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "description": "새로 발급된 JWT Access Token" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Refresh Token이 없거나 유효하지 않음(재로그인 필요)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그아웃 (Refresh Token 쿠키 삭제)",
        "responses": {
          "200": {
            "description": "로그아웃 성공",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "message": { "type": "string", "example": "로그아웃되었습니다." } } }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "patch": {
        "tags": ["Users"],
        "summary": "본인 회원정보 수정",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "전체 회원 목록 조회 (Admin 권한 필요)",
        "description": "Admin 권한 필요",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "회원 목록",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Admin 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "카테고리 전체 조회 (인증 사용자 누구나)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "카테고리 목록",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
              }
            }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "카테고리 등록 (Admin 권한 필요)",
        "description": "Admin 권한 필요",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Admin 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/categories/{categoryId}": {
      "patch": {
        "tags": ["Categories"],
        "summary": "카테고리 수정 (Admin 권한 필요)",
        "description": "Admin 권한 필요",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "categoryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCategoryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Admin 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "존재하지 않는 카테고리",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "카테고리 삭제 (Admin 권한 필요, 참조 중인 Todo는 기본 카테고리로 재할당)",
        "description": "Admin 권한 필요. 삭제되는 카테고리를 참조하던 Todo는 전역 '기본' 카테고리로 자동 재할당된다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "categoryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "message": { "type": "string", "example": "카테고리가 삭제되었습니다." } } }
              }
            }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Admin 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "존재하지 않는 카테고리",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": ["Todos"],
        "summary": "본인 소유 Todo 목록 조회 (카테고리/상태 필터링)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "categoryId", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "카테고리별 필터링" },
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/TodoStatus" }, "description": "상태별 필터링(파생 계산 값: 시작전/진행중/완료/지연)" }
        ],
        "responses": {
          "200": {
            "description": "Todo 목록",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }
              }
            }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "tags": ["Todos"],
        "summary": "Todo 등록",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTodoRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } } }
          },
          "400": {
            "description": "startDate > endDate 등 유효성 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/todos/{todoId}": {
      "patch": {
        "tags": ["Todos"],
        "summary": "Todo 수정 (완료 토글 포함)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "todoId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTodoRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Todo" } } }
          },
          "400": {
            "description": "startDate > endDate 등 유효성 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "소유자가 아님",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "존재하지 않는 Todo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["Todos"],
        "summary": "Todo 삭제",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "todoId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "message": { "type": "string", "example": "Todo가 삭제되었습니다." } } }
              }
            }
          },
          "401": {
            "description": "미인증",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "소유자가 아님",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "존재하지 않는 Todo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token을 `Authorization: Bearer {accessToken}` 헤더로 전달. Refresh Token은 httpOnly 쿠키로만 전달되어 이 스킴에 포함되지 않는다."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string", "example": "인증이 필요합니다." },
              "status": { "type": "integer", "example": 401 }
            },
            "required": ["message", "status"]
          }
        },
        "required": ["error"]
      },
      "Role": {
        "type": "string",
        "enum": ["Member", "Admin"]
      },
      "TodoStatus": {
        "type": "string",
        "enum": ["시작전", "진행중", "완료", "지연"],
        "description": "저장 필드가 아니라 completed와 오늘 날짜/startDate/endDate 비교로 조회 시 파생 계산되는 값"
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer", "example": 1 },
          "email": { "type": "string", "format": "email", "description": "로그인 식별자. 이메일 형식이어야 하며, 실제 존재 여부 검증 없이 회원 목록 내 중복만 체크한다." },
          "name": { "type": "string", "example": "홍길동" },
          "role": { "$ref": "#/components/schemas/Role" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "email", "name", "role", "createdAt", "updatedAt"]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "description": "이메일 형식이어야 하며 기존 회원 목록과 중복될 수 없다." },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "name": { "type": "string" }
        },
        "required": ["email", "password", "name"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "description": "JWT Access Token" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["accessToken", "user"]
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "본인 정보만 수정 가능(이메일은 로그인 식별자이므로 수정 대상에서 제외).",
        "properties": {
          "name": { "type": "string" },
          "password": { "type": "string", "format": "password", "minLength": 8 }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "categoryId": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "업무" },
          "isDefault": { "type": "boolean", "description": "전역 '기본' 카테고리는 시스템 전체에 1개만 존재한다." },
          "createdBy": { "type": "integer", "description": "등록한 Admin의 userId(소유 관계 아님, 기록용)" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["categoryId", "name", "isDefault", "createdAt", "updatedAt"]
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": ["name"]
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": ["name"]
      },
      "Todo": {
        "type": "object",
        "properties": {
          "todoId": { "type": "integer", "example": 1 },
          "userId": { "type": "integer", "description": "소유자, 본인만 접근/수정/삭제 가능" },
          "categoryId": { "type": "integer" },
          "title": { "type": "string" },
          "memo": { "type": "string", "nullable": true },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date", "description": "startDate보다 이전일 수 없다(startDate <= endDate)." },
          "completed": { "type": "boolean" },
          "status": { "$ref": "#/components/schemas/TodoStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["todoId", "userId", "categoryId", "title", "startDate", "endDate", "completed", "status", "createdAt", "updatedAt"]
      },
      "CreateTodoRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "memo": { "type": "string", "nullable": true },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date", "description": "startDate <= endDate 이어야 한다." },
          "categoryId": { "type": "integer", "description": "미지정 시 전역 '기본' 카테고리로 자동 지정된다." }
        },
        "required": ["title", "startDate", "endDate"]
      },
      "UpdateTodoRequest": {
        "type": "object",
